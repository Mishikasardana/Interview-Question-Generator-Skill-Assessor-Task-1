# Copy to .env and fill in your values

# Shared by every LLM-backed module (resume_processing, jd_parsing,
# question_generation, answer_evaluation, semantic_matching,
# recruiter_intelligence) — one set of credentials, one place to configure
# them. Uses Groq (fast, OpenAI-compatible chat completions API).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Legacy GLM/Zhipu settings — no longer used by default (Groq above takes
# priority), kept only so an old .env still works if you set these instead.
# GLM_API_KEY=
# GLM_MODEL=glm-4.5-flash
# GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# API server (all optional — sensible defaults if omitted)
HOST=0.0.0.0
PORT=8000
RELOAD=true
# Comma-separated list of allowed frontend origins, or "*" for local dev.
ALLOWED_ORIGINS=*

# Database (optional — the app works without this, it just won't save
# history; see database/README.md)
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/interview_platform

# Speech-to-text (optional — leave unset to use the free-tier Google Web
# Speech API bundled with the SpeechRecognition library)
GOOGLE_SPEECH_API_KEY=
SPEECH_LANGUAGE=en-IN
